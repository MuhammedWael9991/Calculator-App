<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="com.calculator.screen.CalculatorViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/results_section"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_290sdp"
            android:background="@drawable/result_section"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!--last operation test-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/last_operation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/result_txt"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="start"
                android:layout_marginEnd="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="24dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/doppio_one_regular"
                    android:text="@{viewModel.uiState.expression}"
                    android:textColor="@color/brawn_hint"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_gravity="start"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--result-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/result_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/view"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="start"
                android:layout_marginBottom="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginStart="24dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/doppio_one_regular"
                    android:text="@{viewModel.uiState.result}"
                    android:textColor="@color/brawn"
                    android:textSize="36sp"
                    android:layout_gravity="start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <View
                android:id="@+id/view"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/rounded_rectangel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/buttons_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/results_section"
            android:paddingHorizontal="16dp"
            >

            <!--first row-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/first_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/button_ac"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="AC"
                    android:textColor="@color/brawn"
                    android:onClick="@{() -> viewModel.onClearClick()}"
                    />

                <ImageView
                    android:id="@+id/button_arrow"
                    style="@style/CalcButton"
                    android:src="@drawable/ic_arrow_left"
                    android:padding="30dp"
                    android:background="@drawable/round_button"
                    android:text="←"
                    android:textColor="@color/brawn"
                    android:onClick="@{() -> viewModel.onDeleteLastDigit()}"
                    />

                <TextView
                    android:id="@+id/button_mod"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="%"
                    android:textColor="@color/white"
                    android:onClick="@{() -> viewModel.onOperatorClick(`%`)}"
                    />

                <TextView
                    android:id="@+id/button_divide"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="÷"
                    android:textColor="@color/white"
                    android:onClick="@{() -> viewModel.onOperatorClick(`÷`)}"
                    />

                <!-- Flow -->
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_first_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="button_ac,button_arrow,button_mod,button_divide"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <!--second row-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/second_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/first_row">

                <TextView
                    android:id="@+id/button_7"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="7"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`7`)}"
                    />

                <TextView
                    android:id="@+id/button_8"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="8"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_9"
                    app:layout_constraintStart_toEndOf="@+id/button_7"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`8`)}"
                    />

                <TextView
                    android:id="@+id/button_9"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="9"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_multiply"
                    app:layout_constraintStart_toEndOf="@+id/button_8"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`9`)}"

                    />

                <TextView
                    android:id="@+id/button_multiply"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="x"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/button_9"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onOperatorClick(`x`)}"
                    />

                <!-- Flow -->
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_second_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="button_7,button_8,button_9,button_multiply"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--third row-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/third_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/second_row">

                <TextView
                    android:id="@+id/button_4"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="4"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`4`)}"
                    />

                <TextView
                    android:id="@+id/button_5"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="5"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_6"
                    app:layout_constraintStart_toEndOf="@+id/button_4"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`5`)}"
                    />

                <TextView
                    android:id="@+id/button_6"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="6"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_plus"
                    app:layout_constraintStart_toEndOf="@+id/button_5"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`6`)}"

                    />

                <TextView
                    android:id="@+id/button_plus"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="+"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/button_6"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onOperatorClick(`+`)}"
                    />

                <!-- Flow -->
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_third_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="button_4,button_5,button_6,button_plus"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--fourth row-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fourth_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/third_row">

                <TextView
                    android:id="@+id/button_1"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="1"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`1`)}"
                    />

                <TextView
                    android:id="@+id/button_2"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="2"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_3"
                    app:layout_constraintStart_toEndOf="@+id/button_1"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`2`)}"
                    />

                <TextView
                    android:id="@+id/button_3"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="3"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_minus"
                    app:layout_constraintStart_toEndOf="@+id/button_2"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`3`)}"
                    />

                <TextView
                    android:id="@+id/button_minus"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="-"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/button_3"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onOperatorClick(`-`)}"
                    />

                <!-- Flow -->
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_fourth_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="button_1,button_2,button_3,button_minus"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--fifth row-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fifth_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fourth_row">

                <TextView
                    android:id="@+id/button_plus_minus"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="±"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_zero"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onClickPlusMinus()}"
                    />

                <TextView
                    android:id="@+id/button_zero"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="0"
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_dot"
                    app:layout_constraintStart_toEndOf="@+id/button_plus_minus"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`0`)}"
                    />

                <TextView
                    android:id="@+id/button_dot"
                    style="@style/CalcButton"
                    android:background="@drawable/round_button"
                    android:text="."
                    android:textColor="@color/brawn"
                    app:layout_constraintEnd_toStartOf="@id/button_equal"
                    app:layout_constraintStart_toEndOf="@+id/button_zero"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onNumberClick(`.`)}"

                    />

                <TextView
                    android:id="@+id/button_equal"
                    style="@style/CalcButton"
                    android:background="@drawable/operation_button"
                    android:text="="
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/button_dot"
                    app:layout_constraintTop_toTopOf="parent"
                    android:onClick="@{() -> viewModel.onEqualClick()}"
                    />

                <!-- Flow -->
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_fifth_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="button_plus_minus,button_zero,button_dot,button_equal"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Flow -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_button_section"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                app:constraint_referenced_ids="first_row,second_row,third_row,fourth_row,fifth_row"
                app:flow_verticalGap="8dp"
                app:flow_verticalStyle="spread"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>